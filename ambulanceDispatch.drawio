        <mxCell id="YejxGAvmogdYCIQ8ZGh0-3" parent="6jbhAHh6WlQ1HiFQtKir-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=50;" value="Step 1&lt;br&gt;&lt;br&gt;Complete evaluation and mark call ready for displatch&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;table data-start=&quot;0&quot; data-end=&quot;1239&quot; data-is-last-node=&quot;&quot; data-is-only-node=&quot;&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;tbody data-start=&quot;35&quot; data-end=&quot;1239&quot; data-is-last-node=&quot;&quot; style=&quot;line-height: 300%;&quot;&gt;&lt;tr data-start=&quot;35&quot; data-end=&quot;130&quot;&gt;&lt;td data-start=&quot;35&quot; data-end=&quot;78&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;37&quot; data-end=&quot;77&quot; data-is-only-node=&quot;&quot;&gt;completeEvaluation(callId, evaluation)&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;78&quot; data-end=&quot;130&quot;&gt;Submits the completed emergency-call evaluation.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;131&quot; data-end=&quot;243&quot;&gt;&lt;td data-start=&quot;131&quot; data-end=&quot;174&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;133&quot; data-end=&quot;173&quot; data-is-only-node=&quot;&quot;&gt;completeEvaluation(callId, evaluation)&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;174&quot; data-end=&quot;243&quot;&gt;Forwards the evaluation from the workspace to the MVC controller.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;244&quot; data-end=&quot;371&quot;&gt;&lt;td data-start=&quot;244&quot; data-end=&quot;287&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;246&quot; data-end=&quot;286&quot; data-is-only-node=&quot;&quot;&gt;completeEvaluation(callId, evaluation)&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;287&quot; data-end=&quot;371&quot;&gt;Delegates the evaluation from the controller to the dispatch application facade.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;372&quot; data-end=&quot;482&quot;&gt;&lt;td data-start=&quot;372&quot; data-end=&quot;415&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;374&quot; data-end=&quot;414&quot; data-is-only-node=&quot;&quot;&gt;completeEvaluation(callId, evaluation)&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;415&quot; data-end=&quot;482&quot;&gt;Passes the evaluation to the call center for domain processing.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;483&quot; data-end=&quot;564&quot;&gt;&lt;td data-start=&quot;483&quot; data-end=&quot;503&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;485&quot; data-end=&quot;502&quot; data-is-only-node=&quot;&quot;&gt;getCall(callId)&lt;/code&gt;&lt;/td&gt;&lt;td data-start=&quot;503&quot; data-end=&quot;564&quot; data-col-size=&quot;md&quot;&gt;Retrieves the emergency call associated with the call ID.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;565&quot; data-end=&quot;659&quot;&gt;&lt;td data-start=&quot;565&quot; data-end=&quot;600&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;567&quot; data-end=&quot;599&quot; data-is-only-node=&quot;&quot;&gt;completeEvaluation(evaluation)&lt;/code&gt;&lt;/td&gt;&lt;td data-start=&quot;600&quot; data-end=&quot;659&quot; data-col-size=&quot;md&quot;&gt;Applies the completed evaluation to the emergency call.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;660&quot; data-end=&quot;747&quot;&gt;&lt;td data-start=&quot;660&quot; data-end=&quot;683&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;662&quot; data-end=&quot;682&quot; data-is-only-node=&quot;&quot;&gt;requiresDispatch()&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;683&quot; data-end=&quot;747&quot;&gt;Determines whether the emergency call requires an ambulance.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;748&quot; data-end=&quot;843&quot;&gt;&lt;td data-start=&quot;748&quot; data-end=&quot;775&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;750&quot; data-end=&quot;774&quot; data-is-only-node=&quot;&quot;&gt;markReadyForDispatch()&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;775&quot; data-end=&quot;843&quot;&gt;Marks the emergency call as ready to enter the dispatch process.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;844&quot; data-end=&quot;926&quot;&gt;&lt;td data-start=&quot;844&quot; data-end=&quot;862&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;846&quot; data-end=&quot;861&quot; data-is-only-node=&quot;&quot;&gt;addCall(call)&lt;/code&gt;&lt;/td&gt;&lt;td data-start=&quot;862&quot; data-end=&quot;926&quot; data-col-size=&quot;md&quot;&gt;Adds the ready emergency call to the waiting priority queue.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;927&quot; data-end=&quot;1026&quot;&gt;&lt;td data-start=&quot;927&quot; data-end=&quot;967&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;929&quot; data-end=&quot;966&quot; data-is-only-node=&quot;&quot;&gt;displayCallReadyForDispatch(callId)&lt;/code&gt;&lt;/td&gt;&lt;td data-start=&quot;967&quot; data-end=&quot;1026&quot; data-col-size=&quot;md&quot;&gt;Displays that the emergency call is ready for dispatch.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1027&quot; data-end=&quot;1127&quot;&gt;&lt;td data-start=&quot;1027&quot; data-end=&quot;1059&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;1029&quot; data-end=&quot;1058&quot; data-is-only-node=&quot;&quot;&gt;cancelDispatchRequirement()&lt;/code&gt;&lt;/td&gt;&lt;td data-start=&quot;1059&quot; data-end=&quot;1127&quot; data-col-size=&quot;md&quot;&gt;Marks the emergency call as not requiring an ambulance dispatch.&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1128&quot; data-end=&quot;1239&quot; data-is-last-node=&quot;&quot;&gt;&lt;td data-start=&quot;1128&quot; data-end=&quot;1176&quot; data-col-size=&quot;md&quot;&gt;&lt;code data-start=&quot;1130&quot; data-end=&quot;1175&quot; data-is-only-node=&quot;&quot;&gt;displayCallNoLongerRequiresDispatch(callId)&lt;/code&gt;&lt;/td&gt;&lt;td data-start=&quot;1176&quot; data-end=&quot;1239&quot; data-is-last-node=&quot;&quot; data-col-size=&quot;md&quot;&gt;Displays that the emergency call does not require dispatch.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1059" width="1328" x="3309" y="-870" as="geometry" />
        </mxCell>
