&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td data-start=&quot;1160&quot; data-end=&quot;1213&quot; data-col-size=&quot;lg&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td data-col-size=&quot;lg&quot; data-start=&quot;1213&quot; data-end=&quot;1293&quot;&gt;&lt;strong data-start=&quot;1215&quot; data-end=&quot;1221&quot;&gt;8.&lt;/strong&gt; System sends the emergency assignment to the selected Ambulance Crew.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" vertex="1">
