        <mxCell id="6jbhAHh6WlQ1HiFQtKir-7" parent="6jbhAHh6WlQ1HiFQtKir-5" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=default;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=20;" value="&lt;div&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr data-start=&quot;102&quot; data-end=&quot;318&quot;&gt;&lt;td data-col-size=&quot;lg&quot; data-start=&quot;211&quot; data-end=&quot;318&quot;&gt;&lt;strong data-start=&quot;213&quot; data-end=&quot;219&quot;&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;2.&lt;/strong&gt; System identifies the ambulances that are currently available and appropriate for the emergency.&lt;br&gt;&lt;br&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr data-start=&quot;319&quot; data-end=&quot;456&quot;&gt;&lt;td data-start=&quot;319&quot; data-end=&quot;322&quot; data-col-size=&quot;lg&quot;&gt;&lt;/td&gt;&lt;td data-start=&quot;322&quot; data-end=&quot;456&quot; data-col-size=&quot;lg&quot;&gt;&lt;strong data-start=&quot;324&quot; data-end=&quot;330&quot;&gt;3.&lt;/strong&gt; System determines which available ambulance is the best choice.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr data-start=&quot;1062&quot; data-end=&quot;1208&quot;&gt;&lt;td data-start=&quot;1062&quot; data-end=&quot;1065&quot; data-col-size=&quot;lg&quot;&gt;&lt;/td&gt;&lt;td data-start=&quot;1065&quot; data-end=&quot;1208&quot; data-col-size=&quot;lg&quot;&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;strong data-start=&quot;1355&quot; data-end=&quot;1361&quot;&gt;6.&lt;/strong&gt; System verifies that the selected ambulance is still available and that the emergency call still requires dispatch.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td data-start=&quot;1160&quot; data-end=&quot;1213&quot; data-col-size=&quot;lg&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td data-col-size=&quot;lg&quot; data-start=&quot;1213&quot; data-end=&quot;1293&quot;&gt;&lt;strong data-start=&quot;1215&quot; data-end=&quot;1221&quot;&gt;8.&lt;/strong&gt; System sends the emergency assignment to the selected Ambulance Crew.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" vertex="1">
